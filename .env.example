# ── TerraMind AI – Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Optional: Cesium Ion access token.
# Required only if you want Cesium Ion terrain, imagery, or 3D tilesets.
# Obtain a free token at https://ion.cesium.com/
# Leave empty to use OSM tiles without Ion (default behaviour).
VITE_CESIUM_ION_TOKEN=

# Google Maps Platform browser key (Maps Tile API / 2D tiles).
# Used as the satellite basemap in the 2D MapLibre map and 3D Cesium globe.
# Restrict the key by HTTP referrer in Google Cloud Console. When empty, OSM is used.
VITE_GOOGLE_MAPS_API_KEY=
# satellite (default) | roadmap | terrain
VITE_GOOGLE_MAPS_MAP_TYPE=satellite

# TerraMind backend API base URL (no trailing slash).
# Same-origin API path for Vercel and local Vite development (proxied to port 8000).
VITE_API_BASE_URL=/api


# PostgreSQL and application security. Generate AUTH_SECRET with a cryptographic
# random generator; do not reuse the example values or commit your .env file.
POSTGRES_PASSWORD=
AUTH_SECRET=
# Comma-separated browser origins allowed to call the backend API. For a public
# Vercel demo "*" works; otherwise list your deployed frontend origins.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# On Vercel with Neon, DATABASE_URL (or POSTGRES_URL from the Neon integration)
# is injected automatically. Use the pooled connection string for serverless.
DATABASE_URL=postgresql+psycopg://terramind:replace-me@localhost:5432/terramind
GEE_KEY_HOST_PATH=./secrets/earth-engine-service-account.json
REPORT_STORAGE_DIR=./data/reports
PERSIST_ANALYSIS_JOBS=true
MONITORING_SCHEDULER_ENABLED=false
# Vercel runs `alembic upgrade head` automatically on cold start. Set this on
# other platforms to do the same; otherwise run migrations manually.
# AUTO_MIGRATE=true



# Earth Engine server configuration; never expose real values to frontend code.
GEE_PROJECT=your-google-cloud-project-id
GEE_AUTH_MODE=service_account
GEE_SERVICE_ACCOUNT=earth-engine@your-google-cloud-project-id.iam.gserviceaccount.com
# Preferred: protected service-account JSON key mount
GEE_PRIVATE_KEY_FILE=/run/secrets/earth-engine-service-account.json
# Alternative: GEE_PRIVATE_KEY_JSON=<entire service-account JSON document>
# Vercel alternative: base64 of the whole JSON document (keeps newlines intact):
# GEE_PRIVATE_KEY_B64=<output of: base64 -i service-account.json | tr -d '\n'>
# Or use a runtime workload identity:
# GEE_AUTH_MODE=ambient

MAX_SEARCH_DAYS=3650
MAX_AOI_AREA_SQ_KM=1000000

# Gemini API key (Google AI Studio) used by the backend for every AI
# interpretation, including the Earth Investigator and generated reports.
# Server-side only: never prefix it with VITE_ or send it to the browser.
GEMINI_API_KEY=
# Stable Gemini model used for interpretations. Pin another model if preferred.
GEMINI_MODEL=gemini-3.5-flash
# Optional overrides. Gemini is called through its OpenAI-compatible endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TIMEOUT_SECONDS=30
# Legacy LLM_API_KEY / LLM_MODEL / LLM_BASE_URL / LLM_TIMEOUT_SECONDS names are
# still accepted for existing deployments. The backend also falls back to this
# repository-root .env when it is started from backend/.

# Serverless deployments (Vercel sets VERCEL=1) run each analysis inside its HTTP
# request because instances are frozen after the response. Set this to force the
# same behavior on any platform.
# INLINE_ANALYSIS=true

# Module 8 scheduled regional monitoring (server only)
MONITOR_DB_PATH=terramind_monitoring.sqlite3
MONITOR_SCHEDULER_ENABLED=true
MONITOR_SCHEDULER_POLL_SECONDS=60
MONITOR_SCHEDULER_BATCH_SIZE=2

# Optional outbound email adapter. Email alerts require SMTP settings and a recipient.
# Keep credentials in a secret manager or backend-only environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
