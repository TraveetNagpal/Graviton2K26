# Earth Engine server configuration; never expose real values to frontend code.
GEE_PROJECT=your-google-cloud-project-id
GEE_AUTH_MODE=service_account
GEE_SERVICE_ACCOUNT=earth-engine@your-google-cloud-project-id.iam.gserviceaccount.com
# Preferred: protected service-account JSON key mount
GEE_PRIVATE_KEY_FILE=/run/secrets/earth-engine-service-account.json
# Alternative: GEE_PRIVATE_KEY_JSON=<entire service-account JSON document>
# Or use a runtime workload identity:
# GEE_AUTH_MODE=ambient

MAX_SEARCH_DAYS=3650
MAX_AOI_AREA_SQ_KM=1000000
