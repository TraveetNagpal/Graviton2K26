# ── TerraMind AI – Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Optional: Cesium Ion access token.
# Required only if you want Cesium Ion terrain, imagery, or 3D tilesets.
# Obtain a free token at https://ion.cesium.com/
# Leave empty to use OSM tiles without Ion (default behaviour).
VITE_CESIUM_ION_TOKEN=

# TerraMind backend API base URL (no trailing slash).
# Set to your local dev server during development.
VITE_API_BASE_URL=http://localhost:8000/api/v1
